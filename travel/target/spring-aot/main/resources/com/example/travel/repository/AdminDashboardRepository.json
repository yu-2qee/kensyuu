  "methods": [
    {
      "name": "findPopularHouses",
      "signature": "public abstract java.util.List<java.lang.Object[]> com.example.travel.repository.AdminDashboardRepository.findPopularHouses()",
      "query": {
        "query": "    SELECT r.house.name, COUNT(r)\n    FROM Reservation r\n    GROUP BY r.house.id, r.house.name\n    ORDER BY COUNT(r) DESC\n"
      }
    },
    {
      "name": "getMonthlySales",
      "signature": "public abstract java.lang.Integer com.example.travel.repository.AdminDashboardRepository.getMonthlySales(int,int)",
      "query": {
        "query": "    SELECT COALESCE(SUM(r.amount), 0)\n    FROM Reservation r\n    WHERE YEAR(r.createdAt) = :year\n    AND MONTH(r.createdAt) = :month\n"
      }
    },
